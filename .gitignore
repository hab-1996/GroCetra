*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.matplotlib_cache/

# Virtual environments
venv/
.venv/
env/

# Environment variables and secrets
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Logs and local runtime files
*.log
*.tmp
*.temp
*.pid
output/

# Flask/local app files
instance/
.webassets-cache
*.sqlite
*.sqlite3
*.db
*.db-journal

# Jupyter
.ipynb_checkpoints/

# Node/frontend dependencies and builds
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
build/
dist/
.vite/

# IDE/editor
.vscode/
.idea/
*.swp
*.swo

